@namespace HamkareBlazor
@using HamkareBlazor.Resources
@using HamkareBlazor.Utilities
@inherits HamkareComponentBase

@inject InternalHamkareLocalizer Localizer

<div @attributes="@UserAttributes" class="@Classname" style="@Style">
    <div class="@NavClassname" role="tablist">
        @foreach (var step in _steps)
        {
            bool isActive = ActiveStep == step;
            string stepClassname = new CssBuilder()
                .AddClass("hamkare-step")
                .AddClass("active", isActive)
                .AddClass("hamkare-ripple", Ripple)
                .AddClass("hamkare-clickable", NonLinear && !step.DisabledState.Value)
                .AddClass("hamkare-step-error", step.HasErrorState.Value)
                .AddClass("hamkare-step-completed", step.CompletedState.Value)
                .AddClass("hamkare-step-skipped", step.SkippedState.Value)
                .Build();

            <button class="@stepClassname" role="tab" type="button" id="@GetStepButtonId(step)" aria-controls="@GetStepPanelIdIfRendered(step)" aria-selected="@(isActive.ToString().ToLower())"
                    @onclick="@(async e => await OnStepClickAsync(step, e))" disabled="@step.DisabledState.Value">
                @RenderStepLabel(step, isActive)
            </button>

            @if (Vertical && !(IsCompleted && CompletedContent is not null)) 
            {
                @StepContent(step)
            }

            @if (_steps[^1] != step)
            {
                @if (ConnectorTemplate is not null)
                {
                    @ConnectorTemplate(step)
                }
                else
                {
                    <div class="hamkare-stepper-nav-connector">
                        <div class="hamkare-stepper-nav-connector-line"></div>
                    </div>
                }
            }
        }
    </div>

    @if (IsCompleted && CompletedContent is not null)
    {
        <div class="@StepClassname hamkare-stepper-complete">
            @CompletedContent
        </div>
    }
    else if (!Vertical && _activeStep is not null) {
        @StepContent(_activeStep)
    }

    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>

    <HamkareCardActions Class="hamkare-stepper-actions">
        @if (ActionContent == null)
        {
            @if (ShowResetButton)
            {
                @* Reset Button *@
                <HamkareButton StartIcon="@ResetButtonIcon" Class="hamkare-stepper-button-reset" Disabled="@(!CanReset)" OnClick="@(async () => await ResetAsync())">
                    @Localizer[LanguageResource.HamkareStepper_Reset]
                </HamkareButton>
            }

            @if (!IsCompleted)
            {
                @* Previous Button *@
                <HamkareButton StartIcon="@PreviousButtonIcon" Class="hamkare-stepper-button-previous" OnClick="PreviousStepAsync" Disabled="@(!PreviousStepEnabled)">
                    @Localizer[LanguageResource.HamkareStepper_Previous]
                </HamkareButton>
            }

            <HamkareSpacer/>

            @if (!IsCompleted)
            {
                @if (IsCurrentStepSkippable)
                {
                    @* Skip Button *@
                    <HamkareButton StartIcon="@SkipButtonIcon" Class="hamkare-stepper-button-skip" OnClick="SkipCurrentStepAsync">
                        @Localizer[LanguageResource.HamkareStepper_Skip]
                    </HamkareButton>
                }
                @if (ShowCompleteInsteadOfNext)
                {
                    @* Complete Button *@
                    <HamkareButton StartIcon="@CompleteButtonIcon" Class="hamkare-stepper-button-complete" OnClick="NextStepAsync" Color="Color.Primary">
                        @Localizer[LanguageResource.HamkareStepper_Complete]
                    </HamkareButton>
                }
                else 
                {
                    @* Next Button *@
                    <HamkareButton StartIcon="@NextButtonIcon" Class="hamkare-stepper-button-next" OnClick="NextStepAsync" Color="Color.Primary" Disabled="@(!CanGoToNextStep)">
                        @Localizer[LanguageResource.HamkareStepper_Next]
                    </HamkareButton>
                }
            }
        }
        else
        {
            @ActionContent(this)
        }
    </HamkareCardActions>
</div>

@code {
    private RenderFragment RenderStepLabel(HamkareStep step, bool isActive) =>
        @<div class="@step.LabelClassname">
            @if (LabelTemplate is not null)
            {
                @LabelTemplate(step)
            }
            else
            {
                <div class="@step.LabelIconClassname">
                    @if(step.HasErrorState.Value)
                    {
                        <HamkareIcon Size="Size.Small" Icon="@StepErrorIcon" />
                    }
                    else if(step.SkippedState.Value && ShowSkip)
                    {
                        <HamkareIcon Size="Size.Small" Icon="@StepSkippedIcon" />
                    }
                    else if (step.CompletedState.Value)
                    {
                        <HamkareIcon Size="Size.Small" Icon="@StepCompleteIcon" />
                    }
                    else
                    {
                        <HamkareText Typo="Typo.caption">@(_steps.IndexOf(step) + 1)</HamkareText>
                    }
                </div>
            }

            @if (TitleTemplate is not null)
            {
                @TitleTemplate(step)
            }
            else
            {
                <div class="@step.LabelContentClassname">
                    <HamkareText Typo="@(isActive ? Typo.subtitle2 : Typo.body2)" Class="hamkare-step-label-content-title">
                        @step.Title
                    </HamkareText>

                    @if (!string.IsNullOrEmpty(step.SecondaryText))
                    {
                        <HamkareText Typo="Typo.caption" Class="hamkare-step-label-content-secondary-text">@step.SecondaryText</HamkareText>
                    }
                </div>
            }
        </div>;

    private RenderFragment StepContent(HamkareStep step) =>
        @<CascadingValue Value="@CreateStepContext(step)">
            <div @attributes="@step.UserAttributes" id="@GetStepPanelId(step)" class="@step.Classname" style="@step.Styles" role="tabpanel" aria-labelledby="@GetStepButtonId(step)" tabindex="0">
                @if (step.ChildContent is not null)
                {
                    if (Vertical)
                    {
                        <HamkareCollapse Expanded="step == ActiveStep">
                            @step.ChildContent
                        </HamkareCollapse>
                    }
                    else
                    {
                        @step.ChildContent
                    }
                }
            </div>
        </CascadingValue>;

    private HamkareStepContext CreateStepContext(HamkareStep step) => new(this, step);
}
