@namespace HamkareBlazor
@inherits HamkareComponentBase

<HamkareElement HtmlTag="div" Class="@Classname" Style="@Style" Tag="@Tag" UserAttributes="@UserAttributes">
    <CascadingValue IsFixed="true" Value="this">
        @ChildContent
    </CascadingValue>
</HamkareElement>

@{
    UserAttributes.TryAdd("role", "group");
}
