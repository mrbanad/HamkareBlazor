@namespace HamkareBlazor
@using HamkareBlazor.Resources
@inherits HamkareComponentBase
@inject InternalHamkareLocalizer Localizer

@{
}

<div @attributes="UserAttributes" id="@ElementId" class="hamkare-dialog-container @GetPosition()">
    <HamkareOverlay Visible="true" OnClick="HandleBackgroundClickAsync" Class="@BackgroundClassname" DarkBackground="true" @onmouseup="OnMouseUpAsync" />
    <div @ref="_dialogContainerReference" id="_@Id.ToString("N")" role="dialog" aria-labelledby="@(GetHideHeader() ? null : $"_{Id:N}_title")" class="@Classname" style="@Style" tabindex="-1">
        @if (!GetHideHeader())
        {
            <div id="@($"_{Id:N}_title")" class="@TitleClassname">
                @if (TitleContent is null)
                {
                    <HamkareText Typo="Typo.h6">@_titleState.Value</HamkareText>
                }
                else
                {
                    @TitleContent
                }
                @if (GetCloseButton())
                {
                    <HamkareIconButton aria-label="@Localizer[LanguageResource.HamkareDialog_Close]" @onmousedown:preventDefault="true" Icon="@CloseIcon" @onclick="((IHamkareDialogInstance)this).Cancel" Class="hamkare-button-close" />
                }
            </div>
         }
        <CascadingValue Value="(IHamkareDialogInstanceInternal)this" IsFixed="true">
            @Content
        </CascadingValue>
    </div>
</div>
