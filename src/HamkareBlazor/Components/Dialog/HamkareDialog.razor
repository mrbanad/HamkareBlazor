@namespace HamkareBlazor

@inherits HamkareComponentBase

@{
#nullable enable
#pragma warning disable CS0618 // Type or member is obsolete
}

@*this makes dialog inlineable, it will only render inside a HamkareDialogInstance*@
@if (!IsInline)
{
    <HamkareFocusTrap DefaultFocus="DefaultFocus ?? GlobalDialogOptions.DefaultFocus ?? HamkareBlazor.DefaultFocus.Element">

        <div @attributes="UserAttributes" class="@ContentClassname" style="@ContentStyle">
            <CascadingValue Value="true" IsFixed Name="IsNested">
                @DialogContent
            </CascadingValue>
        </div>

        @if (DialogActions != null)
        {
            <div class="@ActionsClassname">
                @DialogActions
            </div>
        }

    </HamkareFocusTrap>
}
