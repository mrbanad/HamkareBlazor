@namespace HamkareBlazor
@typeparam T
@attribute [CascadingTypeParameter("T")]
@inherits HamkareSelect<T>

@if (ShowSkeleton)
{
    <HamkareSkeletonInput HaveHelper="!string.IsNullOrWhiteSpace(HelperText)"/>
}
else
{
    base.BuildRenderTree(__builder);
}

@code {
  
    [Parameter] public IEnumerable<SelectItemViewModel> List { get; set; } = new List<SelectItemViewModel>();

    public override async Task SetParametersAsync(ParameterView parameters)
    {
        ToStringFunc = parameters.TryGetValue("ToStringFunc", out Func<T?, string>? toStringFunc) ? toStringFunc : CustomToStringFunc;
        ChildContent = parameters.TryGetValue("ChildContent", out RenderFragment? childContent)
            ? childContent
            : typeof(T) == typeof(long)
                ? @<div>
                      @foreach (var item in List)
                      {
                          <HamkareSelectItem Value="@(item.Id)">@item.Name</HamkareSelectItem>
                      }
                  </div>
                : @<div>
                      @foreach (var item in List)
                      {
                          <HamkareSelectItem Value="@((long?)item.Id)">@item.Name</HamkareSelectItem>
                      }
                  </div>;
        await base.SetParametersAsync(parameters);
    }

    private string CustomToStringFunc(T? value)
    {
        var valueString = value?.ToString() ?? string.Empty;
        return string.IsNullOrEmpty(valueString) ? string.Empty : List.FirstOrDefault(z => z.Id == long.Parse(valueString))?.Name ?? string.Empty;
    }

}
