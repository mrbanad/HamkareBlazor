@namespace HamkareBlazor
@inherits HamkareComponentBase

@{
#nullable enable
}

<HamkareDialog @attributes="UserAttributes" Class="@Classname">
    <TitleContent>
        @if (TitleContent is null)
        {
            <HamkareText Typo="Typo.h6">@Title</HamkareText>
        }
        else
        {
            @TitleContent
        }
    </TitleContent>
    <DialogContent>
        @if (MessageContent is not null)
        {
            @MessageContent
        }
        else
        {
            @MarkupMessage
            @Message
        }
    </DialogContent>
    <DialogActions>
        <div tabindex="-1" class="d-contents">
            <HamkareFocusTrap DefaultFocus="DefaultFocus.LastChild">
                @if (CancelButton is not null)
                {
                    <CascadingValue Value="@_cancelCallback">
                        @CancelButton
                    </CascadingValue>
                }
                else if (!string.IsNullOrWhiteSpace(CancelText))
                {
                    <HamkareButton Class="hamkare-message-box__cancel-button" OnClick="OnCancelClicked">@CancelText</HamkareButton>
                }
                @if (NoButton is not null)
                {
                    <CascadingValue Value="@_noCallback">
                        @NoButton
                    </CascadingValue>
                }
                else if (!string.IsNullOrWhiteSpace(NoText))
                {
                    <HamkareButton Class="hamkare-message-box__no-button" OnClick="OnNoClicked">@NoText</HamkareButton>
                }
                @if (YesButton is not null)
                {
                    <CascadingValue Value="@_yesCallback">
                        @YesButton
                    </CascadingValue>
                }
                else if (!string.IsNullOrWhiteSpace(YesText))
                {
                    <HamkareButton Class="hamkare-message-box__yes-button" Color="Color.Primary" OnClick="OnYesClicked">@YesText</HamkareButton>
                }
            </HamkareFocusTrap>
        </div>

    </DialogActions>
</HamkareDialog>
