@namespace HamkareBlazor.Charts

@inherits HamkareChartBase<T, IChartOptions>

@typeparam T

@if (ShowLegend is not false)
{
    <div @attributes="UserAttributes" class="hamkare-chart-legend">
        @foreach (var item in Data)        
        {
            <div class="hamkare-chart-legend-item" 
                 @onclick:stopPropagation=@(ChartContainer!=null)
                 @onclick=@(async ()=>{ if (OnLegendSelected.HasDelegate) { await OnLegendSelected.InvokeAsync(item.Index); }})>
                @if(CanHideSeries == false)
                {
                    <span class="hamkare-chart-legend-marker" style="@($"background-color:{ChartPalette!.GetValue(item.Index % ChartPalette.Length)}")"></span>
                    <HamkareText Typo="Typo.body2" HtmlTag="span">@item.Labels</HamkareText>
                }
                else
                {   
                    <div class="hamkare-chart-legend-checkbox" style="@GetCheckBoxStyle(item.Index)">    
                        <HamkareCheckBox Value="@item.Visible" ValueChanged="@((bool value) => item.HandleCheckboxChangeAsync())" Size="Size.Small" Dense></HamkareCheckBox>
                        <HamkareText Typo="Typo.body2" Class="ml-n2 align-self-end" HtmlTag="span">@item.Labels</HamkareText>
                    </div> 
                }                 
            </div>
        }
    </div>
}
