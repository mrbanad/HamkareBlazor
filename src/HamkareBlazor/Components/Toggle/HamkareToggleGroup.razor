@namespace HamkareBlazor
@attribute [CascadingTypeParameter(nameof(T))]
@inherits HamkareComponentBase
@typeparam T

<CascadingValue Value="this" IsFixed="true">
    <div role="group" class="@Classname" style="@Stylename" @attributes="UserAttributes">
        @ChildContent
    </div>
</CascadingValue>
