@namespace HamkareBlazor
@using HamkareBlazor.Resources
@inherits HamkareComponentBase
@inject InternalHamkareLocalizer Localizer

<HamkareElement HtmlTag="ul" Class="@Classname" Style="@Style" Tag="@Tag" UserAttributes="@UserAttributes">
    @if (ShowFirstButton)
    {
        <li class="@ItemClassname">
            <HamkareIconButton Icon="@FirstIcon" Size="@Size" Variant="@Variant" Disabled="@(_selectedState.Value == 1 || Disabled)" OnClick="@(() => OnClickControlButtonAsync(Page.First))" aria-label="@Localizer[LanguageResource.HamkarePagination_FirstPage]"></HamkareIconButton>
        </li>
    }
    @if (ShowPreviousButton)
    {
        <li class="@ItemClassname">
            <HamkareIconButton Icon="@BeforeIcon" Size="@Size" Variant="@Variant" Disabled="@(_selectedState.Value == 1 || Disabled)" OnClick="@(() => OnClickControlButtonAsync(Page.Previous))" aria-label="@Localizer[LanguageResource.HamkarePagination_PreviousPage]"></HamkareIconButton>
        </li>
    }
    @if (ShowPageButtons)
    {
        foreach (var state in GeneratePagination())
        {
            var currentPage = state;
            if (currentPage == -1)
            {
                <li class="@ItemClassname">
                    <HamkareText disabled="@Disabled">...</HamkareText>
                </li>
            }
            else if (currentPage == _selectedState.Value)
            {
                <li class="@SelectedItemClassname">
                    <HamkareButton Variant="@(Variant == Variant.Outlined ? Variant.Outlined : Variant.Filled)" Size="@Size" Ripple="false" Disabled="@Disabled" Color="@Color" aria-current="page" aria-label="@Localizer[LanguageResource.HamkarePagination_CurrentPage, $"{currentPage}"]">@currentPage</HamkareButton>
                </li>
            }
            else
            {
                <li class="@ItemClassname">
                    <HamkareButton OnClick="@(() => SetSelectedAsync(currentPage))" Variant="@Variant" Size="@Size" Ripple="false" Disabled="@Disabled" aria-label="@Localizer[LanguageResource.HamkarePagination_PageIndex, $"{currentPage}"]">@currentPage</HamkareButton>
                </li>
            }
        }
    }
    @if (ShowNextButton)
    {
        <li class="@ItemClassname">
            <HamkareIconButton Icon="@NextIcon" Variant="@Variant" Size="@Size" Disabled="@(_selectedState.Value == _countState.Value || Disabled)" OnClick="@(() => OnClickControlButtonAsync(Page.Next))" aria-label="@Localizer[LanguageResource.HamkarePagination_NextPage]"></HamkareIconButton>
        </li>
    }
    @if (ShowLastButton)
    {
        <li class="@ItemClassname">
            <HamkareIconButton Icon="@LastIcon" Variant="@Variant" Size="@Size" Disabled="@(_selectedState.Value == _countState.Value || Disabled)" OnClick="@(() => OnClickControlButtonAsync(Page.Last))" aria-label="@Localizer[LanguageResource.HamkarePagination_LastPage]"></HamkareIconButton>
        </li>
    }
</HamkareElement>
