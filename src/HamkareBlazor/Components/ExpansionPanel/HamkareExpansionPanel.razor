@namespace HamkareBlazor
@inherits HamkareComponentBase

<div @attributes="UserAttributes" class="@Classname" style="@Style">
    <div class="@HeaderClassname" @onclick="ToggleExpansionAsync" tabindex="@(Disabled ? null : "0")" @onkeydown="HandleKeyDownAsync">
        <div class="hamkare-expand-panel-text">
            @if (TitleContent is not null)
            {
                @TitleContent
            }
            else
            {
                @Text
            }
        </div>
        @if (!HideIcon)
        {
            <HamkareIcon Icon="@Icon" class="@(_expandedState.Value ? "hamkare-expand-panel-icon hamkare-transform" : "hamkare-expand-panel-icon")" />
        }
    </div>
    <HamkareCollapse Expanded="_expandedState.Value" MaxHeight="@MaxHeight">
        @if (KeepContentAlive || _expandedState.Value)
        {
            <div class="@PanelContentClassname">
                @ChildContent
            </div>
        }
    </HamkareCollapse>
</div>
