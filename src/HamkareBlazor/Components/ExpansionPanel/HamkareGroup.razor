@using HamkareBlazor
@namespace HamkareBlazor

@if (TitleContent != null)
{
    <HamkareExpansionPanel Text="@Title" HideIcon="true" Expanded="@Expanded" Gutters="false">

        <TitleContent>
            @TitleContent
        </TitleContent>

        <ChildContent>

            <HamkareGrid Spacing="3" Class="px-5 py-3" Style="align-items: center">
                @ChildContent
            </HamkareGrid>

        </ChildContent>

    </HamkareExpansionPanel>
}
else
{
    <HamkareExpansionPanel Text="@Title" HideIcon="true" Expanded="@Expanded" Gutters="false">

        <ChildContent>

            <HamkareGrid Spacing="3" Class="px-5 py-3" Style="align-items: center">
                @ChildContent
            </HamkareGrid>

        </ChildContent>

    </HamkareExpansionPanel>
}

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool Expanded { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? TitleContent { get; set; }
}
