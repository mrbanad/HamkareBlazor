@namespace HamkareBlazor
@using Microsoft.AspNetCore.Components.Routing
@using HamkareBlazor.Resources
@inherits HamkareComponentBase
@inject InternalHamkareLocalizer Localizer

<div class="@GetPanelClass()" @attributes="UserAttributes">
    @if (_sections.Count > 1)
    {
        <HamkareNavMenu Class="pl-4" aria-label="@Localizer[LanguageResource.HamkarePageContentNavigation_NavMenu]">
            <HamkareText Typo="Typo.subtitle1" Class="title" GutterBottom="true">
                @Headline
            </HamkareText>

            @foreach (var docSection in _sections.OrderBy(x => x.LevelSortingValue))
            {
                <HamkareNavLink @key="docSection.Id" Match="NavLinkMatch.All" Class="@GetNavLinkClass(docSection)" @onclick="@(e => OnNavLinkClick(docSection.Id))">
                    @docSection.Title
                </HamkareNavLink>
            }
        </HamkareNavMenu>
    }
</div>
