@namespace HamkareBlazor
@inherits HamkareComponentBase

@{
    #nullable enable
}

<div @attributes="UserAttributes" id="hamkare-snackbar-container" class="@Classname" style="@Style">
    @foreach (var snackbar in Snackbar)
    {
        <HamkareSnackbarElement @key="snackbar" Snackbar="@snackbar"></HamkareSnackbarElement>
    }
</div>
