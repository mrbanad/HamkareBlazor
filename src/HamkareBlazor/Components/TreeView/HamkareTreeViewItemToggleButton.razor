@using HamkareBlazor.Resources
@namespace HamkareBlazor
@inherits HamkareComponentBase
@inject InternalHamkareLocalizer Localizer

<div @attributes="UserAttributes" class="hamkare-treeview-item-arrow" @ondblclick="OnDoubleClick" @ondblclick:stopPropagation="true">
    @if (Visible)
    {
        <HamkareIconButton Disabled="@Disabled"
                       OnClick="@ToggleAsync"
                       Icon="@(Loading ? LoadingIcon : ExpandedIcon)"
                       Color="@(Loading ? LoadingIconColor : ExpandedIconColor)"
                       Class="@Classname"
                       Style="@Style"
                       aria-label="@(Expanded ? @Localizer[LanguageResource.HamkareTreeView_CollapseItem] : @Localizer[LanguageResource.HamkareTreeView_ExpandItem])" />
    }
</div>

