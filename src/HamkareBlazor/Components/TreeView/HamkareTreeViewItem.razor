@namespace HamkareBlazor
@inherits HamkareComponentBase
@typeparam T

@if (Visible)
{
    <li @attributes="UserAttributes" class="@Classname" style="@Style">
        <div class="@ContentClassname" @onclick="OnItemClickedAsync" @onclick:stopPropagation="true" @ondblclick="OnItemDoubleClickedAsync" @ondblclick:stopPropagation="true">
            @if (Content != null)
            {
                @Content
            }
            else
            {
                <HamkareTreeViewItemToggleButton Disabled="@GetDisabled()" Loading="_loading" Expanded="_expandedState.Value" ExpandedChanged="OnItemExpanded" Visible="@(HasChildren() && AreChildrenVisible())" ExpandedIcon="@ExpandButtonIcon" ExpandedIconColor="@ExpandButtonIconColor" LoadingIcon="@LoadingIcon" LoadingIconColor="LoadingIconColor"></HamkareTreeViewItemToggleButton>

                @if (MultiSelection)
                {
                    <HamkareCheckBox T="bool?" TriState Class="hamkare-treeview-item-checkbox" CheckedIcon="@CheckedIcon" UncheckedIcon="@UncheckedIcon" IndeterminateIcon="@GetIndeterminateIcon()"
                                 @bind-Value:get="GetCheckBoxStateTriState()" @bind-Value:set="@(x=>OnCheckboxChangedAsync())" Disabled="@Disabled"></HamkareCheckBox>
                }

                @if (HasIcon)
                {
                    <div class="hamkare-treeview-item-icon">
                        <HamkareIcon Disabled="@GetDisabled()" Icon="@GetIcon()" Color="@IconColor" />
                    </div>
                }

                @if (BodyContent != null)
                {
                    @BodyContent(this)
                }
                else
                {
                    <HamkareText Typo="@TextTypo" Class="@TextClassname">
                        @GetText()
                    </HamkareText>

                    @if (!string.IsNullOrEmpty(EndText))
                    {
                        <HamkareText Typo="@EndTextTypo" Class="@EndTextClass">
                            @EndText
                        </HamkareText>
                    }

                    @if (!string.IsNullOrEmpty(EndIcon))
                    {
                        <div class="hamkare-treeview-item-icon">
                            <HamkareIcon Disabled="@Disabled" Icon="@EndIcon" Color="@EndIconColor" />
                        </div>
                    }
                }
            }
        </div>
        @if (HasChildren())
        {
            <HamkareCollapse Expanded="@_expandedState.Value">
                <CascadingValue Value="@HamkareTreeRoot" IsFixed="true">
                    <CascadingValue Value="this" IsFixed="true">
                        <HamkareTreeView Items="@_itemsState.Value" ItemTemplate="HamkareTreeRoot?.ItemTemplate" Class="hamkare-treeview-group">
                            @ChildContent
                        </HamkareTreeView>
                    </CascadingValue>
                </CascadingValue>
            </HamkareCollapse>
        }
    </li>
}
