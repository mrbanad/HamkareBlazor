@namespace HamkareBlazor
@using HamkareBlazor.Resources
@typeparam T
@inherits HamkareComponentBase
@inject InternalHamkareLocalizer Localizer

<div class="hamkare-chip-container"
     id="@_chipContainerId"
     @onkeydown="@HandleKeyDownAsync">
    <HamkareElement HtmlTag="@GetHtmlTag()"
                Class="@Classname"
                Style="@Style"
                @attributes="GetAttributes()"
                @onclick="@((IsButton ? this.AsNonRenderingEventHandler<MouseEventArgs>(OnClickAsync) : null)!)">
        @{
            if (AvatarContent is not null)
            {
                @AvatarContent
            }
            else if (!string.IsNullOrEmpty(Icon) && !ShowCheckMark)
            {
                <HamkareIcon Disabled="@Disabled" Icon="@Icon" Class="hamkare-chip-icon" Size="HamkareBlazor.Size.Small" Color="@GetIconColor()" />
            }
            else if (ShowCheckMark)
            {
                <HamkareIcon Disabled="@Disabled" Icon="@GetCheckedIcon()" Class="hamkare-chip-icon" Size="HamkareBlazor.Size.Small" />
            }
        }
        <span class="hamkare-chip-content">
            @if (ChildContent is null)
            {
                @if(Text is null) {
                    @($"{Value}")
                }
                else {
                    @Text
                }
            }
            else
            {
                @ChildContent
            }
            @if (IsClosable)
            {
                <HamkareIconButton Class="hamkare-chip-close-button"
                               Icon="@GetCloseIcon()"
                               OnClick="OnCloseAsync"
                               Size="HamkareBlazor.Size.Small"
                               Disabled="@Disabled"
                               aria-label="@Localizer[LanguageResource.HamkareChip_Close]"
                               tabindex="-1"/>
            }
        </span>
    </HamkareElement>
</div>
