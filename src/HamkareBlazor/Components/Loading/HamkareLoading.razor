<div id="custom-loader">
    <img src="/images/logo.svg" alt="logo" class="logo"/>
    <div class="spinner">
        <div></div>
        <div></div>
        <div></div>
    </div>
</div>

<style>
    #custom-loader {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .logo {
        margin-bottom: 50px;
        width: 30%;
        min-width: 340px;
    }

    .spinner {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-bottom: 20px;
    }

    .spinner div {
        width: 24px;
        height: 24px;
        margin: 16px;
        border-radius: 50%;
        animation: bounce 1.2s infinite ease-in-out;
    }

    .spinner div:nth-child(2) {
        animation-delay: 0.2s;
    }

    .spinner div:nth-child(3) {
        animation-delay: 0.4s;
    }

    @@keyframes bounce {
        0%, 80%, 100% {
            transform: scale(0);
        }
        40% {
            transform: scale(1);
        }
    }
</style>

<script>

    window.addEventListener('DOMContentLoaded', () => {
        let PanelColorPrimary = localStorage.getItem('PanelColorPrimary') || '#444';
        let PanelColorBackground = localStorage.getItem('PanelColorBackground') || '#fff';

        // حذف کوتیشن اضافی
        try {
            PanelColorPrimary = JSON.parse(PanelColorPrimary);
        } catch(e) {}

        try {
            PanelColorBackground = JSON.parse(PanelColorBackground);
        } catch(e) {}

        const customLoader = document.getElementById('custom-loader');
        const spinnerDots = document.querySelectorAll('.spinner div');

        customLoader.style.backgroundColor = PanelColorBackground;
        spinnerDots.forEach(dot => {
            dot.style.backgroundColor = PanelColorPrimary;
        });
    });

                                                    </script>
