@namespace HamkareBlazor
@inherits HamkareComponentBase
@typeparam T
@using HamkareBlazor.Resources
@inject InternalHamkareLocalizer Localizer

<HamkareToolBar @attributes="UserAttributes" Class="@Classname" Style="@Style">
    <div class="hamkare-table-pagination-spacer"></div>
    @if (PageSizeSelector)
    {
        <HamkareText Typo="Typo.body2" Class="hamkare-table-pagination-caption">
            @RowsPerPageString
        </HamkareText>
        <HamkareSelect T="int" ValueChanged="@SetRowsPerPageAsync" Value="@(DataGrid?.RowsPerPage ?? 0)" Class="hamkare-table-pagination-select" Underline="false" Dense="true" Disabled="@Disabled" SelectionOnEnter="true">
            @foreach (int pageSize in PageSizeOptions)
            {
                if (pageSize == int.MaxValue)
                {
                    <HamkareSelectItem T="int" Value="@pageSize">@AllItemsText</HamkareSelectItem>
                }
                else 
                {
                    <HamkareSelectItem T="int" Value="@pageSize">@pageSize.ToString().ToUpper()</HamkareSelectItem>
                }
            }
        </HamkareSelect>
    }

    @if (ShowPageNumber)
    {
        <HamkareText Typo="Typo.body2" Class="hamkare-table-pagination-caption">
            @Info
        </HamkareText>
    }
    
    @if (ShowNavigation)
    {
        <div class="hamkare-table-pagination-actions">
            <HamkareIconButton Class="hamkare-flip-x-rtl" Icon="@Icons.Material.Filled.FirstPage" Disabled="@BackButtonsDisabled" @onclick="@(() => DataGrid?.NavigateTo(Page.First))" aria-label="@Localizer[LanguageResource.HamkareDataGridPager_FirstPage]" />
            <HamkareIconButton Class="hamkare-flip-x-rtl" Icon="@Icons.Material.Filled.NavigateBefore" Disabled="@BackButtonsDisabled" @onclick="@(() => DataGrid?.NavigateTo(Page.Previous))" aria-label="@Localizer[LanguageResource.HamkareDataGridPager_PreviousPage]" />
            <HamkareIconButton Class="hamkare-flip-x-rtl" Icon="@Icons.Material.Filled.NavigateNext" Disabled="@ForwardButtonsDisabled" @onclick="@(() => DataGrid?.NavigateTo(Page.Next))" aria-label="@Localizer[LanguageResource.HamkareDataGridPager_NextPage]" />
            <HamkareIconButton Class="hamkare-flip-x-rtl" Icon="@Icons.Material.Filled.LastPage" Disabled="@ForwardButtonsDisabled" @onclick="@(() => DataGrid?.NavigateTo(Page.Last))" aria-label="@Localizer[LanguageResource.HamkareDataGridPager_LastPage]" />
        </div>
    }

</HamkareToolBar>

