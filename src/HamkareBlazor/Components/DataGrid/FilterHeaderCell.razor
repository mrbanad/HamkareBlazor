@using HamkareBlazor.Extensions
@using HamkareBlazor.Resources
@namespace HamkareBlazor
@inherits HamkareComponentBase
@typeparam T

@inject InternalHamkareLocalizer Localizer

@if (!Column.HiddenState.Value)
{
    <th scope="col" class="@Classname" style="@Stylename" colspan="@Column.HeaderColSpan" @attributes="@UserAttributes">
        @if (Column.filterable && Column.FilterTemplate != null)
        {
            @Column.FilterTemplate(Column.FilterContext)
        }
        else if (Column.filterable)
        {
            <HamkareStack Row="true">
                @if (fieldType.IsString && !(@operator ?? "").EndsWith("empty"))
                {
                    <HamkareTextField T="string" Value="@valueString" ValueChanged="@StringValueChangedAsync" FullWidth="true" Placeholder="@Localizer[LanguageResource.HamkareDataGrid_FilterValue]" Margin="@Margin.Dense" Immediate="true" DebounceInterval="@(!DataGrid.HasServerData ? 0 : 500.0)" />
                }
                else if (fieldType.IsNumber && !(@operator ?? "").EndsWith("empty"))
                {
                    <HamkareNumericField T="double?" Culture="@Column.Culture" Value="@valueNumber" ValueChanged="@NumberValueChangedAsync" FullWidth="true" Placeholder="@Localizer[LanguageResource.HamkareDataGrid_FilterValue]" Margin="@Margin.Dense" Immediate="true" DebounceInterval="@(!DataGrid.HasServerData ? 0 : 500.0)" />
                }
                else if (fieldType.IsEnum)
                {
                    <HamkareSelect T="Enum" Value="@valueEnum" ValueChanged="@EnumValueChangedAsync" FullWidth="true" Dense="true" Margin="@Margin.Dense">
                        <HamkareSelectItem T="Enum" Value="@(null)"></HamkareSelectItem>
                        @foreach (var item in EnumExtensions.GetSafeEnumValues(fieldType.InnerType))
                        {
                            <HamkareSelectItem T="Enum" Value="@item">@Localizer[item]</HamkareSelectItem>
                        }
                    </HamkareSelect>
                }
                else if (fieldType.IsBoolean)
                {
                    <HamkareSelect T="bool?" Value="@valueBool" ValueChanged="@BoolValueChangedAsync" FullWidth="true" Dense="true" Margin="@Margin.Dense">
                        <HamkareSelectItem T="bool?" Value="@(null)"></HamkareSelectItem>
                        <HamkareSelectItem T="bool?" Value="@(true)">@Localizer[LanguageResource.HamkareDataGrid_True]</HamkareSelectItem>
                        <HamkareSelectItem T="bool?" Value="@(false)">@Localizer[LanguageResource.HamkareDataGrid_False]</HamkareSelectItem>
                    </HamkareSelect>
                }
                else if (fieldType.IsDateOnly && !(@operator ?? "").EndsWith("empty"))
                {
                    <HamkareDatePicker Date="@valueDateOnlyForPicker" DateChanged="@DateOnlyValueChangedAsync" Margin="@Margin.Dense" />
                }
                else if (fieldType.IsDateTime && !(@operator ?? "").EndsWith("empty"))
                {
                    <HamkareGrid Spacing="0">
                        <HamkareItem xs="7">
                            <HamkareDatePicker Date="@valueDateTimeForPicker" DateChanged="@DateTimeValueChangedAsync" Margin="@Margin.Dense" />
                        </HamkareItem>
                        <HamkareItem xs="5">
                            <HamkareTimePicker Time="@valueTime" TimeChanged="@TimeValueChangedAsync" Margin="@Margin.Dense" />
                        </HamkareItem>
                    </HamkareGrid>
                }
                @if (!Column.ShowFilterIcon.HasValue || Column.ShowFilterIcon.Value)
                {
                    <HamkareMenu Class="column-filter-menu" Icon="@DataGrid.FilterIconFilled" Size="@Size.Small" Dense="true">
                        @foreach (var o in operators)
                        {
                            if (!string.IsNullOrWhiteSpace(o))
                            {
                                <HamkareMenuItem Style="@chosenOperatorStyle(o)" OnClick="@(async () => await ChangeOperatorAsync(o))">@Localizer[FilterOperator.GetTranslationKeyByOperatorName(o)]</HamkareMenuItem>
                            }
                        }
                    </HamkareMenu>
                    <HamkareIconButton Class="align-self-center filter-button clear" Icon="@DataGrid.FilterIconClear" Size="@Size.Small" OnClick="@ClearFilterAsync" aria-label="@Localizer[LanguageResource.HamkareDataGrid_ClearFilter]"></HamkareIconButton>
                }
            </HamkareStack>
        }
    </th>
}
