@namespace HamkareBlazor
@inherits HamkareComponentBase
@using System.Diagnostics
@using HamkareBlazor.Resources
@using Microsoft.JSInterop
@typeparam T

@inject InternalHamkareLocalizer Localizer
@inject IJSRuntime JSRuntime

@if (IsOnlyHeader)
{
    <th scope="col" class="hamkare-table-cell @Classname" style="" @attributes="@UserAttributes">
        @ChildContent
    </th>
}
else if (Column != null && !Column.HiddenState.Value)
{
    <th @ref=@_headerElement scope="col" class="@Classname" style="@Stylename" colspan="@Column.HeaderColSpan" @attributes="@UserAttributes">
        @if (DataGrid.DragDropColumnReordering)
        {
            <HamkareDropZone CanDrop="@((item) => (Column.DragAndDropEnabled ?? true))" ItemDisabled="@((item) => !item.DragAndDropEnabled ?? false)" T="Column<T>" Identifier="@(Column.PropertyName ?? _id)">

            </HamkareDropZone>
        }
        else
        {
            @TableHeader()
        }
        @if (resizable)
        {
            <div @ref="_resizerElement"
                 @onpointerdown="this.AsNonRenderingEventHandler<PointerEventArgs>(OnResizerPointerDown)" 
                 @onpointerdown:stopPropagation="true"
                 @onpointermove="this.AsNonRenderingEventHandler<PointerEventArgs>(OnResizerPointerMove)" 
                 @onpointerup="this.AsNonRenderingEventHandler<PointerEventArgs>(OnResizerPointerUp)"
                 @onpointerover="@OnResizerPointerOver"
                 @onpointerleave="this.AsNonRenderingEventHandler(OnResizerPointerLeave)"
                 class="@ResizerClass" style="@ResizerStyle" />
        }
    </th>
}

@code {
#nullable enable

    internal RenderFragment TableHeader()
    {
        Debug.Assert(Column is not null);
        Debug.Assert(DataGrid is not null);
        var headerTemplate = Column.GetHeaderTemplate();

        return
        @<text>
        <span class="column-header">
            @if (sortable)
            {
                <span class="@SortHeaderClass" @onclick="SortChangedAsync">
                    @if (headerTemplate != null)
                    {
                        @headerTemplate(Column.headerContext);
                    }
                    else if (IncludeHierarchyToggle)
                    {
                        @HierarchyToggle
                    }
                    else 
                    {
                        @computedTitle
                    }
                </span>
            }
            else
            { 
                @if (headerTemplate != null)
                {
                    @headerTemplate(Column.headerContext);
                }
                else if (IncludeHierarchyToggle)
                {
                    @HierarchyToggle
                }
                else 
                {
                    @computedTitle
                }
            }
            <span class="@OptionsClass">
                @if (sortable)
                {
                    if (SortDirection == SortDirection.None)
                    {
                        <HamkareIconButton Icon="@Column.SortIcon" Class="@sortIconClass" Size="@Size.Small" OnClick="@SortChangedAsync" aria-label="@Localizer[LanguageResource.HamkareDataGrid_Sort]"></HamkareIconButton>
                    }
                    else
                    {
                        <HamkareIconButton Icon="@Column.SortIcon" Class="@sortIconClass" Size="@Size.Small" OnClick="@SortChangedAsync" aria-label="@Localizer[LanguageResource.HamkareDataGrid_Sort]"></HamkareIconButton>
                    }

                    if (DataGrid.SortMode == SortMode.Multiple)
                    {
                        if (Column.SortIndex < 0)
                        {
                            <span class="hamkare-sort-index hamkare-text-disabled invisible">@(Column.SortIndex + 1)</span>
                        }
                        else
                        {
                            <span class="hamkare-sort-index hamkare-text-disabled">@(Column.SortIndex + 1)</span>
                        }
                    }
                }

                @if (DataGrid.FilterMode != DataGridFilterMode.ColumnFilterRow)
                {
                    if (hasFilter)
                    {
                        <HamkareIconButton Class="filter-button filtered" Icon="@DataGrid.FilterIconFilled" Size="@Size.Small" OnClick="@OpenFilters" aria-label="@Localizer[LanguageResource.HamkareDataGrid_OpenFilters]"></HamkareIconButton>
                    }
                    else if (showFilterIcon)
                    {
                        <HamkareIconButton Class="filter-button" Icon="@DataGrid.FilterIconEmpty" Size="@Size.Small" OnClick="@AddFilter" aria-label="@Localizer[LanguageResource.HamkareDataGrid_AddFilter]"></HamkareIconButton>
                    }
                }

                @if (showColumnOptions)
                {
                    <HamkareMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AriaLabel="@Localizer[LanguageResource.HamkareDataGrid_ShowColumnOptions]">
                        <HamkareMenuItem Disabled="@(SortDirection == SortDirection.None)" OnClick="@RemoveSortAsync">@Localizer[LanguageResource.HamkareDataGrid_Unsort]</HamkareMenuItem>
                        @if (filterable && DataGrid.FilterMode != DataGridFilterMode.ColumnFilterRow)
                        {
                            <HamkareMenuItem OnClick="@AddFilter">@Localizer[LanguageResource.HamkareDataGrid_Filter]</HamkareMenuItem>
                        }
                        @if (hideable)
                        {
                            <HamkareMenuItem OnClick="@HideColumnAsync">@Localizer[LanguageResource.HamkareDataGrid_Hide]</HamkareMenuItem>
                        }
                        @if (groupable)
                        {
                            if (Column?.GroupingState.Value ?? false)
                            {
                                <HamkareMenuItem OnClick="@UngroupColumnAsync">@Localizer[LanguageResource.HamkareDataGrid_Ungroup]</HamkareMenuItem>
                            }
                            else
                            {
                                <HamkareMenuItem OnClick="@GroupColumnAsync">@Localizer[LanguageResource.HamkareDataGrid_Group]</HamkareMenuItem>
                            }
                        }
                    </HamkareMenu>
                }
                @if (DataGrid.DragDropColumnReordering && (Column.DragAndDropEnabled ?? true))
                {
                    <HamkareIconButton Icon="@DataGrid.DragIndicatorIcon" Size="@DataGrid.DragIndicatorSize" Class="drag-icon-options"></HamkareIconButton>
                }
            </span>
        </span>
        @if (filterable && DataGrid.FilterMode == DataGridFilterMode.ColumnFilterMenu)
        {
            <HamkareOverlay @bind-Visible="@_filtersMenuVisible" AutoClose />
            <HamkarePopover UserAttributes="@DataGrid?.PositionAttributes" Open="@_filtersMenuVisible" AnchorOrigin="@Origin.BottomRight" TransformOrigin="@Origin.TopRight" Class="pa-4 column-filter-popup hamkare-popover-position-override">
                @if (Column.FilterTemplate != null)
                {
                    @Column.FilterTemplate(Column.FilterContext) 
                }
                else
                {
                    <HamkareGrid>
                        <HamkareItem xs="12">
                            @DataGrid?.Filter(Column.FilterContext.FilterDefinition!, Column)
                        </HamkareItem>
                        <HamkareItem xs="12" Class="d-flex justify-end">
                            <HamkareButton Class="clear-filter-button" OnClick="@ClearFilterAsync">@Localizer[LanguageResource.HamkareDataGrid_Clear]</HamkareButton>
                            <HamkareButton Class="apply-filter-button" Color="@Color.Primary" OnClick="@ApplyFilterAsync">@Localizer[LanguageResource.HamkareDataGrid_Filter]</HamkareButton>
                        </HamkareItem>
                    </HamkareGrid>
                }
            </HamkarePopover>
        }
        </text>;
    }

    private RenderFragment HierarchyToggle =>
        @<text>
             <HamkareIconButton Icon="@GetGroupIcon()"
                            Class="ma-n3 pa-1 hamkare-hierarchy-toggle-button"
                            OnClick="@ToggleHierarchyAsync"
                            aria-label="@(Expanded ? @Localizer[LanguageResource.HamkareDataGrid_CollapseAllGroups] : @Localizer[LanguageResource.HamkareDataGrid_ExpandAllGroups])"/>
         </text>;

}
