@namespace HamkareBlazor
@inherits HamkareComponentBase
@typeparam T
@using HamkareBlazor.Utilities
@using HamkareBlazor.Extensions
@using HamkareBlazor.Resources
@inject InternalHamkareLocalizer Localizer

@{
#nullable enable
    _currentRenderFilteredItemsCache = null;
}

<CascadingValue IsFixed="true" Value="this">@Columns</CascadingValue>

<CascadingValue IsFixed="true" Value="this">
    <div @attributes="UserAttributes" class="@Classname" style="@Stylename">
        @if (Items != null || HasServerData)
        {
            @if (ToolBarContent != null)
            {
                <HamkareToolBar Class="hamkare-table-toolbar" Style="@HeaderFooterStyle">
                    @ToolBarContent
                    @if (ShowMenuIcon)
                    {
                        @ToolbarMenu(this)
                    }
                </HamkareToolBar>
            }
            else
            {
                @if (ShowMenuIcon)
                {
                    @*Add the default toolbar.*@
                    <HamkareToolBar Class="hamkare-table-toolbar" Style="@HeaderFooterStyle">
                        <HamkareSpacer />
                        @ToolbarMenu(this)
                    </HamkareToolBar>
                }
            }
            <div @ref=_gridElement class="@TableClass" style="@TableStyle">
                <HamkareDropContainer @ref="_dropContainer" T="Column<T>" Items="@RenderedColumns" ItemsSelector="(item, dropzone) => RenderedColumnsItemsSelector(item, dropzone)" ItemDropped="ItemUpdatedAsync" CanDropClass="@DropAllowedClass" NoDropClass="@DropNotAllowedClass" ApplyDropClassesOnDragStarted="@ApplyDropClassesOnDragStarted">
                    <ChildContent>
                        <table class="hamkare-table-root">
                            @if (ColGroup != null)
                            {
                                <colgroup>
                                    @ColGroup
                                </colgroup>
                            }
                            <thead class="@HeadClassname">
                                <CascadingValue Name="IsOnlyHeader" IsFixed="true" Value="true">
                                    @Header
                                </CascadingValue>
                                <tr class="hamkare-table-row">
                                    @foreach (var column in RenderedColumns)
                                    {
                                        <HeaderCell SortDirection="@(GetColumnSortDirection(column.PropertyName))" T="T" Column="@column"></HeaderCell>
                                    }
                                </tr>
                                @if (_filtersMenuVisible && FilterMode == DataGridFilterMode.Simple)
                                {
                                    <HamkareOverlay @bind-Visible="@_filtersMenuVisible" AutoClose OnClosed="@CloseFilters"></HamkareOverlay>
                                    <tr class="hamkare-table-row" style="visibility: collapse; opacity: 0;overflow: hidden;">
                                        <th colspan="@RenderedColumns.Count" class="hamkare-table-cell hamkare-filter-panel-cell">
                                            <HamkarePopover UserAttributes="@PositionAttributes" Open="@_filtersMenuVisible" Paper="true" Class="filters-panel pa-2 hamkare-popover-position-override" OverflowBehavior="OverflowBehavior.FlipAlways" AnchorOrigin="Origin.TopLeft"
                                                        TransformOrigin="Origin.TopLeft" Elevation="4" Style="width:700px;max-width:700px;" MaxHeight="400">
                                                @if (FilterTemplate == null)
                                                {
                                                    <HamkareStack>
                                                        @foreach (var f in FilterDefinitions)
                                                        {
                                                            @Filter(f, null)
                                                        }
                                                    </HamkareStack>
                                                    <HamkareButton Class="mt-2" StartIcon="@Icons.Material.Filled.Add" OnClick="@AddFilter" Color="@Color.Primary">@Localizer[LanguageResource.HamkareDataGrid_AddFilter]</HamkareButton>
                                                    @if (HasServerData)
                                                    {
                                                        <HamkareButton Class="mt-2" StartIcon="@Icons.Material.Filled.Add" OnClick="@ApplyFiltersAsync" Color="@Color.Primary">@Localizer[LanguageResource.HamkareDataGrid_Apply]</HamkareButton>
                                                    }
                                                    <HamkareButton Class="mt-2" StartIcon="@Icons.Material.Filled.Remove" OnClick="@ClearFiltersAsync" Color="@Color.Primary">@Localizer[LanguageResource.HamkareDataGrid_Clear]</HamkareButton>
                                                }
                                                else
                                                {
                                                    @FilterTemplate(this)
                                                }
                                            </HamkarePopover>
                                        </th>
                                    </tr>
                                }
                                @if (_columnsPanelVisible)
                                {
                                    <HamkareOverlay @bind-Visible="_columnsPanelVisible" AutoClose></HamkareOverlay>
                                    <tr class="hamkare-table-row" style="visibility: collapse; opacity: 0; overflow: hidden;">
                                        <th colspan="@RenderedColumns.Count" class="hamkare-table-cell hamkare-filter-panel-cell">
                                            <HamkarePopover UserAttributes="@PositionAttributes" Open="@_columnsPanelVisible" Paper="true" Class="hamkare-data-grid-columns-panel px-2 hamkare-popover-position-override" OverflowBehavior="OverflowBehavior.FlipAlways"
                                                        AnchorOrigin="Origin.TopLeft"
                                                        TransformOrigin="Origin.TopLeft" Elevation="4"
                                                        Style="max-width:700px;" MaxHeight="400">
                                                <HamkareStack Row="true" Justify="Justify.FlexEnd">
                                                    <div style="min-width:250px">
                                                        <HamkareTextField DebounceInterval="500" @bind-Value="@_columnsPanelSearch" OnDebounceIntervalElapsed="@(() => _columnsPanelDropContainer?.Refresh())"
                                                        Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" FullWidth="true" />
                                                    </div>
                                                </HamkareStack>

                                                <HamkareDropContainer @ref="_columnsPanelDropContainer" T="Column<T>" Items="@RenderedColumns" ItemsSelector="(item, dropzone) => true"
                                                ItemDisabled="@((item) => !this.ColumnsPanelReordering)" ItemDropped="ColumnOrderUpdated">
                                                    <ChildContent>
                                                        <HamkareDropZone T="Column<T>" Class="flex-grow-1" AllowReorder=this.ColumnsPanelReordering />
                                                    </ChildContent>
                                                    <ItemRenderer>
                                                        @if (string.IsNullOrEmpty(_columnsPanelSearch) || context.Title?.Contains(_columnsPanelSearch, StringComparison.InvariantCultureIgnoreCase) == true)
                                                        {
                                                            <HamkareStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Style="border-bottom: 1px solid var(--hamkare-palette-table-lines);">
                                                                @if (ColumnsPanelReordering)
                                                                {
                                                                    <HamkareStack Spacing="0">
                                                                        @if (RenderedColumns.IndexOf(context) != 0)
                                                                        {
                                                                            <HamkareIconButton Ripple="false" Icon="@Icons.Material.Filled.ArrowDropUp" Size="@Size.Small" title=@Localizer[LanguageResource.HamkareDataGrid_MoveUp] Disabled="@(RenderedColumns.IndexOf(context) == 0)" OnClick="@(e => ColumnUp(context))"></HamkareIconButton>
                                                                        }
                                                                        @if (RenderedColumns.IndexOf(context) != RenderedColumns.Count - 1)
                                                                        {
                                                                            <HamkareIconButton Ripple="false" Icon="@Icons.Material.Filled.ArrowDropDown" Size="@Size.Small" title=@Localizer[LanguageResource.HamkareDataGrid_MoveDown] Disabled="@(RenderedColumns.IndexOf(context) == RenderedColumns.Count - 1)" OnClick="@(e => ColumnDown(context))"></HamkareIconButton>
                                                                        }
                                                                    </HamkareStack>
                                                                }

                                                                @if (context.GroupingState.Value)
                                                                {
                                                                    <HamkareIconButton Ripple="false" Icon="@Icons.Material.Filled.AccountTree" Size="@Size.Small" title=@Localizer[LanguageResource.HamkareDataGrid_Ungroup] Disabled="!context.groupable" OnClick="@(e => context.HeaderCell.UngroupColumnAsync())"></HamkareIconButton>
                                                                }
                                                                else
                                                                {
                                                                    <HamkareIconButton Ripple="false" Icon="@Icons.Material.Filled.TableRows" Size="@Size.Small" title=@Localizer[LanguageResource.HamkareDataGrid_Group] Disabled="!context.groupable" OnClick="@(e => context.HeaderCell.GroupColumnAsync())"></HamkareIconButton>
                                                                }
                                                                <HamkareSwitch T="bool" Ripple="false" Class="flex-grow-1" Color="Color.Primary" Disabled="@(!context.hideable)" Value="@context.HiddenState.Value" ValueChanged="@context.ToggleAsync" Converter="_oppositeBoolConverter" Label="@context.Title" />
                                                                <HamkareSpacer />

                                                                <div>
                                                                    <HamkareIconButton Ripple="false" Icon="@context.SortIcon" Class="@context.HeaderCell.sortIconClass" Size="@Size.Small" title=@Localizer[LanguageResource.HamkareDataGrid_Sort] Disabled="!context.sortable" OnClick="@(e => context.HeaderCell.SortChangedAsync(e))"></HamkareIconButton>
                                                                    @if (context.DataGrid.SortMode == SortMode.Multiple)
                                                                    {
                                                                        if (context.SortIndex < 0)
                                                                        {
                                                                            <span class="hamkare-sort-index hamkare-text-disabled invisible">@(context.SortIndex + 1)</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="hamkare-sort-index hamkare-text-disabled">@(context.SortIndex + 1)</span>
                                                                        }
                                                                    }
                                                                </div>

                                                                @if (context.HeaderCell.hasFilter)
                                                                {
                                                                    <HamkareIconButton Ripple="false" Class="filter-button filtered" Icon="@context.DataGrid.FilterIconFilled" Size="@Size.Small" title=@Localizer[LanguageResource.HamkareDataGrid_Filter] Disabled="!context.filterable" OnClick="@context.HeaderCell.OpenFilters"></HamkareIconButton>
                                                                }
                                                                else
                                                                {
                                                                    <HamkareIconButton Ripple="false" Class="filter-button" Icon="@context.DataGrid.FilterIconEmpty" Size="@Size.Small" title=@Localizer[LanguageResource.HamkareDataGrid_Filter] Disabled="!context.filterable" OnClick="@context.HeaderCell.AddFilter"></HamkareIconButton>
                                                                }

                                                                @if (ColumnsPanelReordering)
                                                                {
                                                                    <HamkareIconButton Ripple="false" Icon="@context.DataGrid.DragIndicatorIcon" Size="@Size.Small" Class="drag-icon-options"></HamkareIconButton>
                                                                }
                                                            </HamkareStack>
                                                        }
                                                    </ItemRenderer>
                                                </HamkareDropContainer>
                                                <HamkareStack Row="true">
                                                    @if (Groupable)
                                                    {
                                                        <HamkareButton OnClick="@CollapseAllGroupsAsync" Color="@Color.Primary">@Localizer[LanguageResource.HamkareDataGrid_CollapseAllGroups]</HamkareButton>
                                                        <HamkareButton OnClick="@ExpandAllGroupsAsync" Color="@Color.Primary">@Localizer[LanguageResource.HamkareDataGrid_ExpandAllGroups]</HamkareButton>
                                                    }
                                                    <HamkareSpacer />

                                                    <HamkareButton OnClick="@HideAllColumnsAsync" Color="@Color.Primary">@Localizer[LanguageResource.HamkareDataGrid_HideAll]</HamkareButton>
                                                    <HamkareButton OnClick="@ShowAllColumnsAsync" Color="@Color.Primary">@Localizer[LanguageResource.HamkareDataGrid_ShowAll]</HamkareButton>
                                                </HamkareStack>
                                            </HamkarePopover>
                                        </th>
                                    </tr>
                                }
                                @if (Filterable && FilterMode == DataGridFilterMode.ColumnFilterRow)
                                {
                                    <tr class="hamkare-table-row">
                                        @foreach (var column in RenderedColumns)
                                        {
                                            <FilterHeaderCell T="T" Column="@column" />
                                        }
                                    </tr>
                                }
                                @if (Loading)
                                {
                                    <tr>
                                        <th colspan="1000" class="hamkare-table-loading">
                                            <HamkareProgressLinear Color="@LoadingProgressColor" Class="hamkare-table-loading-progress" Indeterminate="true" />
                                        </th>
                                    </tr>
                                }
                            </thead>
                            <tbody class="hamkare-table-body">
                                @if (Virtualize || CurrentPageItems.Count() > 0)
                                {
                                    if (IsGrouped)
                                    {
                                        var groupItemsPage = GroupItemsPage;
                                        var groupDefinitions = GetGroupDefinitions(_groupDefinition!, groupItemsPage);
                                        if (!groupItemsPage.Any())
                                        {
                                            <tr>
                                                <th colspan="1000" class="hamkare-table-empty-row">
                                                    <div Class="my-3">
                                                        @NoRecordsContent
                                                    </div>
                                                </th>
                                            </tr>
                                        }
                                        foreach (var g in groupDefinitions)
                                        {
                                            <DataGridGroupRow T="T" Items="@g.Grouping" 
                                            GroupDefinition="@g"                                                             
                                            GroupClass="@GroupClass"
                                            GroupStyle="@GroupStyle"
                                            GroupClassFunc="@GroupClassFunc"
                                            GroupStyleFunc="@GroupStyleFunc"
                                            DataGrid="this"
                                            RowClick="@(args => OnRowClickedAsync(args.args, args.item, args.index))"
                                            ContextRowClick="@(args => OnContextMenuClickedAsync(args.args, args.item, args.index))" />
                                        }
                                    }
                                    else
                                    {
                                        <DataGridVirtualizeRow T="T" DataGrid="this" 
                                        RowClick="@(args => OnRowClickedAsync(args.args, args.item, args.index))" 
                                        ContextRowClick="@(args => OnContextMenuClickedAsync(args.args, args.item, args.index))" />
                                    }
                                }
                                else if (Loading ? LoadingContent != null : NoRecordsContent != null)
                                {
                                    <tr>
                                        <th colspan="1000" class="hamkare-table-empty-row">
                                            <div Class="my-3">
                                                @if (Loading)
                                                {
                                                    @LoadingContent
                                                }
                                                else
                                                {
                                                    @NoRecordsContent
                                                }
                                            </div>
                                        </th>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="@FootClassname">
                                <tr class="hamkare-table-row">
                                    @FooterCells(CurrentPageItems)
                                </tr>
                            </tfoot>
                        </table>
                    </ChildContent>
                    <ItemRenderer>
                        @context.HeaderCell.TableHeader()
                    </ItemRenderer>
                </HamkareDropContainer>
            </div>
            @if (PagerContent != null)
            {
                <div class="hamkare-table-pagination" style="@HeaderFooterStyle">
                    @PagerContent
                </div>
            }
        }
    </div>
    <CascadingValue Value="true" IsFixed Name="IsNested">
        <HamkareDialog Options="EditDialogOptions" @bind-Visible="_isEditFormOpen" DefaultFocus="DefaultFocus.FirstChild">
            <DialogContent>
                <HamkareForm @ref="_editForm" FieldChanged="FormFieldChanged">
                    @foreach (var column in RenderedColumns)
                    {
                        var cell = new Cell<T>(this, column, _editingItem!);

                        if (column.EditTemplate != null)
                        {
                            @column.EditTemplate(cell._cellContext)
                        }
                        else
                        {
                            var propertyType = column.PropertyType;

                            if (propertyType == typeof(string))
                            {
                                <HamkareTextField T="string" Label="@column.Title" Value="@cell._valueString" ValueChanged="@cell.StringValueChangedAsync" Margin="@Margin.Dense"
                                Required="@column.Required" Variant="@Variant.Outlined" Disabled="@(!column.Editable || ReadOnly)" Class="mt-4" Culture="@column.Culture" />
                            }
                            else if (TypeIdentifier.IsNumber(propertyType))
                            {
                                <HamkareNumericField T="double?" Label="@column.Title" Value="@cell._valueNumber" ValueChanged="@cell.NumberValueChangedAsync" Margin="@Margin.Dense"
                                Required="@column.Required" Variant="@Variant.Outlined" Disabled="@(!column.Editable || ReadOnly)" Class="mt-4" Culture="@column.Culture" />
                            }
                        }
                    }
                </HamkareForm>
            </DialogContent>
            <DialogActions>
                <HamkareButton Variant="Variant.Filled" Color="Color.Default" OnClick="@CancelEditingItemAsync" Class="px-10">@Localizer[LanguageResource.HamkareDataGrid_Cancel]</HamkareButton>
                <HamkareButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@CommitItemChangesAsync" Class="px-10">@Localizer[LanguageResource.HamkareDataGrid_Save]</HamkareButton>
            </DialogActions>
        </HamkareDialog>
    </CascadingValue>
</CascadingValue>

@code {

    internal RenderFragment ToolbarMenu(HamkareDataGrid<T> dataGrid) =>
    @<text>
        <HamkareMenu Icon="@Icons.Material.Outlined.Settings" Size="Size.Small" Dense="true">
            <HamkareMenuItem OnClick="@dataGrid.ShowColumnsPanel">@Localizer[LanguageResource.HamkareDataGrid_Columns]</HamkareMenuItem>
                @if (dataGrid.IsGrouped)
                {
                    <HamkareMenuItem OnClick="@dataGrid.ExpandAllGroupsAsync">@Localizer[LanguageResource.HamkareDataGrid_ExpandAllGroups]</HamkareMenuItem>
                    <HamkareMenuItem OnClick="@dataGrid.CollapseAllGroupsAsync">@Localizer[LanguageResource.HamkareDataGrid_CollapseAllGroups]</HamkareMenuItem>
                }
                @if (dataGrid.HasHierarchyColumn)
                {
                    <HamkareMenuItem OnClick="@dataGrid.ExpandAllHierarchy">@Localizer[LanguageResource.HamkareDataGrid_ExpandAllGroups]</HamkareMenuItem>
                    <HamkareMenuItem OnClick="@dataGrid.CollapseAllHierarchy">@Localizer[LanguageResource.HamkareDataGrid_CollapseAllGroups]</HamkareMenuItem>
                }
                @if (dataGrid.HasServerData)
                {
                    <HamkareMenuItem OnClick="@dataGrid.InvokeServerLoadFunc">@Localizer[LanguageResource.HamkareDataGrid_RefreshData]</HamkareMenuItem>
                }
            </HamkareMenu>
         </text>
    ;



    internal RenderFragment FooterCells(IEnumerable<T> currentItems) =>
        @<text>
             @if (currentItems is not null)
             {
                 foreach (var column in RenderedColumns)
                 {
                     if (!column.HiddenState.Value)
                     {
                         if (column.AggregateDefinition is not null || column.GetFooterTemplate() is not null || HasFooter)
                         {
                             <FooterCell T="T" Column="@column" CurrentItems="@currentItems"></FooterCell>
                         }
                     }
                 }
             }
         </text>;


    internal RenderFragment Cell(Column<T> column, T item) =>
        @<text>
             @{
                 var cell = new Cell<T>(this, column, item);
             }
             <td data-label="@column.Title" class="@cell.ComputedClass" style="@cell.ComputedStyle">
                 @if (column.Editable && !ReadOnly && EditMode == DataGridEditMode.Cell)
                 {
                     if (column.EditTemplate is not null)
                     {
                         @column.EditTemplate(cell._cellContext)
                     }
                     else
                     {
                         if (column.PropertyType == typeof(string))
                         {
                             <HamkareTextField T="string"
                                           Value="@cell._valueString"
                                           ValueChanged="@cell.StringValueChangedAsync"
                                           Margin="@Margin.Dense" Style="margin-top:0"
                                           Required="@column.Required"
                                           Variant="@Variant.Text" Culture="@column.Culture" />
                         }
                         else if (column.isNumber)
                         {
                             <HamkareNumericField T="double?"
                                              Value="@cell._valueNumber"
                                              ValueChanged="@cell.NumberValueChangedAsync"
                                              Margin="@Margin.Dense" Style="margin-top:0"
                                              Required="@column.Required"
                                              Variant="@Variant.Text" Culture="@column.Culture" />
                         }
                     }
                 }
                 else
                 {
                     var cellTemplate = column.GetCellTemplate();
                     if (cellTemplate is not null)
                     {
                         @cellTemplate(cell._cellContext)
                     }
                     else if (column.Culture is not null && column.isNumber)
                     {
                         if (column.ContentFormat is not null)
                         {
                             @(((IFormattable?)cell._valueNumber)?.ToString(column.ContentFormat, column.Culture))
                         }
                         else
                         {
                             @cell._valueNumber?.ToString(column.Culture)
                         }
                     }
                     else
                     {
                         if (column.ContentFormat is not null)
                         {
                             @(((IFormattable?)cell.ComputedValue)?.ToString(column.ContentFormat, column.Culture))
                         }
                         else
                         {
                             @cell.ComputedValue
                         }
                     }
                 }
             </td>
         </text>;

    internal RenderFragment Filter(IFilterDefinition<T> filterDefinition, Column<T>? column) =>
        @<text>
            @{
                var filter = new Filter<T>(this, filterDefinition, column);
                var fieldType = filterDefinition.FieldType;
            }
            @if (column is null)
            {
                <HamkareGrid Spacing="0">
                    <HamkareItem xs="1" Class="d-flex">
                        <HamkareIconButton Class="remove-filter-button" Icon="@Icons.Material.Filled.Close" OnClick="@filter.RemoveFilterAsync" Size="@Size.Small" Style="align-self: flex-end" aria-label="@Localizer[LanguageResource.HamkareDataGrid_RemoveFilter]"></HamkareIconButton>
                    </HamkareItem>
                    <HamkareItem xs="4">
                        <HamkareSelect T="Column<T>" Value="@filterDefinition.Column" ValueChanged="@filter.FieldChanged" FullWidth="true" Label="@Localizer[LanguageResource.HamkareDataGrid_Column]" Dense="true" Margin="@Margin.Dense"
                                   Class="filter-field">
                            @foreach (var renderColumn in RenderedColumns.Where(x => x.Filterable != false) ?? Enumerable.Empty<Column<T>>())
                            {
                                <HamkareSelectItem T="Column<T>" Value="@renderColumn">@renderColumn.Title</HamkareSelectItem>
                            }
                        </HamkareSelect>
                    </HamkareItem>
                    <HamkareItem xs="3">
                        <HamkareSelect @bind-Value="filterDefinition.Operator" FullWidth="true" Label="@Localizer[LanguageResource.HamkareDataGrid_Operator]" Dense="true" Margin="@Margin.Dense"
                                   Class="filter-operator">
                            @foreach (var fieldOperator in filterDefinition.Column!.GetFilterOperators(fieldType))
                            {
                                <HamkareSelectItem Value="@fieldOperator">@Localizer[FilterOperator.GetTranslationKeyByOperatorName(fieldOperator)]</HamkareSelectItem>
                            }
                        </HamkareSelect>
                    </HamkareItem>
                    <HamkareItem xs="4">
                        @if (fieldType.IsString && !(filterDefinition.Operator ?? "").EndsWith("empty"))
                        {
                            <HamkareTextField T="string" Value="@filter._valueString" ValueChanged="@filter.StringValueChanged" FullWidth="true" Label="@Localizer[LanguageResource.HamkareDataGrid_Value]" Placeholder="@Localizer[LanguageResource.HamkareDataGrid_FilterValue]" Margin="@Margin.Dense"
                                          Immediate="true" Class="filter-input" />
                        }
                        else if (fieldType.IsNumber && !(filterDefinition.Operator ?? "").EndsWith("empty"))
                        {
                            <HamkareNumericField T="double?" Value="@filter._valueNumber" ValueChanged="@filter.NumberValueChanged" FullWidth="true" Label="@Localizer[LanguageResource.HamkareDataGrid_Value]" Placeholder="@Localizer[LanguageResource.HamkareDataGrid_FilterValue]" Margin="@Margin.Dense"
                                             Immediate="true" Class="filter-input" Culture="@filter.FilterColumn?.Culture"/>
                        }
                        else if (fieldType.IsEnum)
                        {
                            <HamkareSelect T="Enum" Value="@filter._valueEnum" ValueChanged="@filter.EnumValueChanged" FullWidth="true" Label="@Localizer[LanguageResource.HamkareDataGrid_Value]" Placeholder="@Localizer[LanguageResource.HamkareDataGrid_FilterValue]" Dense="true" Margin="@Margin.Dense"
                                       Class="filter-input">
                                <HamkareSelectItem T="Enum" Value="@(null)"></HamkareSelectItem>
                                @foreach (var item in EnumExtensions.GetSafeEnumValues(fieldType.InnerType))
                                {
                                    <HamkareSelectItem T="Enum" Value="@item">@Localizer[item]</HamkareSelectItem>
                                }
                            </HamkareSelect>
                        }
                        else if (fieldType.IsBoolean)
                        {
                            <HamkareSelect T="bool?" Value="@filter._valueBool" ValueChanged="@filter.BoolValueChanged" FullWidth="true" Label="@Localizer[LanguageResource.HamkareDataGrid_Value]" Placeholder="@Localizer[LanguageResource.HamkareDataGrid_FilterValue]" Dense="true" Margin="@Margin.Dense"
                                       Class="filter-input">
                                <HamkareSelectItem T="bool?" Value="@(null)"></HamkareSelectItem>
                                <HamkareSelectItem T="bool?" Value="@(true)">@Localizer[LanguageResource.HamkareDataGrid_True]</HamkareSelectItem>
                                <HamkareSelectItem T="bool?" Value="@(false)">@Localizer[LanguageResource.HamkareDataGrid_False]</HamkareSelectItem>
                            </HamkareSelect>
                        }
                        else if (fieldType.IsDateOnly && !(filterDefinition.Operator ?? "").EndsWith("empty"))
                        {
                            <HamkareDatePicker Date="@filter._valueDateOnlyForPicker" DateChanged="@filter.DateOnlyValueChanged" Label="@Localizer[LanguageResource.HamkareDataGrid_Value]" Placeholder="@Localizer[LanguageResource.HamkareDataGrid_FilterValue]" Margin="@Margin.Dense" Class="filter-input-date"/>
                        }
                        else if (fieldType.IsDateTime && !(filterDefinition.Operator ?? "").EndsWith("empty"))
                        {
                            <HamkareGrid Spacing="0">
                                <HamkareItem xs="7">
                                    <HamkareDatePicker Date="@filter._valueDateTimeForPicker" DateChanged="@filter.DateValueChanged" Label="@Localizer[LanguageResource.HamkareDataGrid_Value]" Placeholder="@Localizer[LanguageResource.HamkareDataGrid_FilterValue]" Margin="@Margin.Dense" Class="filter-input-date"/>
                                </HamkareItem>
                                <HamkareItem xs="5">
                                    <HamkareTimePicker Time="@filter._valueTime" TimeChanged="@filter.TimeValueChanged" Label="@Localizer[LanguageResource.HamkareDataGrid_Value]" Placeholder="@Localizer[LanguageResource.HamkareDataGrid_FilterValue]" Margin="@Margin.Dense" Class="filter-input-time" />
                                </HamkareItem>
                            </HamkareGrid>
                        }
                        else if (fieldType.IsGuid)
                        {
                            <HamkareTextField T="Guid?" Value="@filter._valueGuid" ValueChanged="@filter.GuidValueChanged" FullWidth="true" Label="@Localizer[LanguageResource.HamkareDataGrid_Value]" Placeholder="@Localizer[LanguageResource.HamkareDataGrid_FilterValue]" Margin="@Margin.Dense"
                                          Immediate="true" Class="filter-input"/>
                        }
                    </HamkareItem>
                </HamkareGrid>
            }
            else
            {
                <HamkareGrid Spacing="0">
                    <HamkareItem xs="12">
                        <HamkareSelect @bind-Value="filterDefinition.Operator" FullWidth="true" Dense="true" Margin="@Margin.Dense"
                                   Class="filter-operator">
                            @foreach (var o in column.GetFilterOperators(fieldType))
                            {
                                <HamkareSelectItem Value="@o">@Localizer[FilterOperator.GetTranslationKeyByOperatorName(o)]</HamkareSelectItem>
                            }
                        </HamkareSelect>
                    </HamkareItem>
                    <HamkareItem xs="12">
                        @if (fieldType.IsString && !(filterDefinition.Operator ?? "").EndsWith("empty"))
                        {
                            <HamkareTextField T="string" Value="@filter._valueString" ValueChanged="@filter.StringValueChanged" FullWidth="true" Placeholder="@Localizer[LanguageResource.HamkareDataGrid_FilterValue]" Margin="@Margin.Dense"
                                          Immediate="true" Class="filter-input"/>
                        }
                        else if (fieldType.IsNumber && !(filterDefinition.Operator ?? "").EndsWith("empty"))
                        {
                            <HamkareNumericField T="double?" Value="@filter._valueNumber" ValueChanged="@filter.NumberValueChanged" FullWidth="true" Placeholder="@Localizer[LanguageResource.HamkareDataGrid_FilterValue]" Margin="@Margin.Dense"
                                             Immediate="true" Class="filter-input" Culture="@filter.FilterColumn?.Culture"/>
                        }
                        else if (fieldType.IsEnum)
                        {
                            <HamkareSelect T="Enum" Value="@filter._valueEnum" ValueChanged="@filter.EnumValueChanged" FullWidth="true" Placeholder="@Localizer[LanguageResource.HamkareDataGrid_FilterValue]" Dense="true" Margin="@Margin.Dense"
                                       Class="filter-input">
                                <HamkareSelectItem T="Enum" Value="@(null)"></HamkareSelectItem>
                                @foreach (var item in EnumExtensions.GetSafeEnumValues(fieldType.InnerType))
                                {
                                    <HamkareSelectItem T="Enum" Value="@item">@Localizer[item]</HamkareSelectItem>
                                }
                            </HamkareSelect>
                        }
                        else if (fieldType.IsBoolean)
                        {
                            <HamkareSelect T="bool?" Value="@filter._valueBool" ValueChanged="@filter.BoolValueChanged" FullWidth="true" Placeholder="@Localizer[LanguageResource.HamkareDataGrid_FilterValue]" Dense="true" Margin="@Margin.Dense"
                                       Class="filter-input">
                                <HamkareSelectItem T="bool?" Value="@(null)"></HamkareSelectItem>
                                <HamkareSelectItem T="bool?" Value="@(true)">@Localizer[LanguageResource.HamkareDataGrid_True]</HamkareSelectItem>
                                <HamkareSelectItem T="bool?" Value="@(false)">@Localizer[LanguageResource.HamkareDataGrid_False]</HamkareSelectItem>
                            </HamkareSelect>
                        }
                        else if (fieldType.IsDateOnly && !(filterDefinition.Operator ?? "").EndsWith("empty"))
                        {
                            <HamkareDatePicker Date="@filter._valueDateOnlyForPicker" DateChanged="@filter.DateOnlyValueChanged" Placeholder="@Localizer[LanguageResource.HamkareDataGrid_FilterValue]" Margin="@Margin.Dense" Class="filter-input-date"/>
                        }
                        else if (fieldType.IsDateTime && !(filterDefinition.Operator ?? "").EndsWith("empty"))
                        {
                            <HamkareGrid Spacing="0">
                                <HamkareItem xs="7">
                                    <HamkareDatePicker Date="@filter._valueDateTimeForPicker" DateChanged="@filter.DateValueChanged" Placeholder="@Localizer[LanguageResource.HamkareDataGrid_FilterValue]" Margin="@Margin.Dense" Class="filter-input-date"/>
                                </HamkareItem>
                                <HamkareItem xs="5">
                                    <HamkareTimePicker Time="@filter._valueTime" TimeChanged="@filter.TimeValueChanged" Placeholder="@Localizer[LanguageResource.HamkareDataGrid_FilterValue]" Margin="@Margin.Dense" Class="filter-input-time"/>
                                </HamkareItem>
                            </HamkareGrid>
                        }
                        else if (fieldType.IsGuid)
                        {
                            <HamkareTextField T="Guid?" Value="@filter._valueGuid" ValueChanged="@filter.GuidValueChanged" FullWidth="true" Placeholder="@Localizer[LanguageResource.HamkareDataGrid_FilterValue]" Margin="@Margin.Dense"
                                          Immediate="true" Class="filter-input"/>
                        }
                    </HamkareItem>
                </HamkareGrid>
            }
         </text>;
}
