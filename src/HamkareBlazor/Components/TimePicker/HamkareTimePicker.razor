@namespace HamkareBlazor
@inherits HamkarePicker<TimeSpan?>
@inject InternalHamkareLocalizer Localizer

@Render

@code {
    protected override RenderFragment PickerContent => 
    @<CascadingValue Value="@this" IsFixed="true">
        <HamkarePickerToolbar Class="@ToolbarClassname" Style="@Style" ShowToolbar="@ShowToolbar" Orientation="@Orientation" PickerVariant="@PickerVariant" Color="@Color">
            <div class="hamkare-timepicker-hourminute hamkare-ltr">
                @if (TimeEditMode == TimeEditMode.Normal)
                {
                    <HamkareButton Variant="@Variant.Text" Color="@Color.Inherit" Class="@HoursButtonClassname" OnClick="@OnHourClickAsync">@GetHourString()</HamkareButton>
                    <HamkareText Typo="@Typo.h2" Class="hamkare-timepicker-separator">:</HamkareText>
                    <HamkareButton Variant="@Variant.Text" Color="@Color.Inherit" Class="@MinuteButtonClassname" OnClick="@OnMinutesClick">@GetMinuteString()</HamkareButton>
                }
                else
                {
                    <HamkareText Typo="Typo.h2" Class="hamkare-timepicker-separator">@GetHourString():@GetMinuteString()</HamkareText>
                }
            </div>
            @if (AmPm)
            {
                <div class="hamkare-timepicker-ampm">
                    <HamkareButton Variant="@Variant.Text" Color="@Color.Inherit" Class="@AmButtonClassname" OnClick="OnAmClickedAsync">AM</HamkareButton>
                    <HamkareButton Variant="@Variant.Text" Color="@Color.Inherit" Class="@PmButtonClassname" OnClick="OnPmClickedAsync">PM</HamkareButton>
                </div>
            }
        </HamkarePickerToolbar>
        <HamkarePickerContent>
            <div class="hamkare-picker-time-container">
                <div class="hamkare-picker-time-clock">
                    <div tabindex="-1" class="hamkare-picker-time-clock-mask" @ref="ClockElementReference" @oncontextmenu:preventDefault>
                        <div class="@GetClockPinColor()"></div>
                        <div class="@GetClockPointerColor()" style="height: @GetPointerHeight(); transform: @GetPointerRotation()">
                            <div class="@GetClockPointerThumbColor()"></div>
                        </div>
                        <div class="@HourDialClassname">
                            @if (AmPm)
                            {
                                @*Hours from 1 to 12*@
                                for (int i = 1; i <= 12; ++i)
                                {
                                    var _i = i;
                                    var angle = (6 - _i) * 30;
                                    <HamkareText Class="@GetNumberColor(_i)" Style="@GetTransform(angle, 109, 0, 5)">@_i</HamkareText>
                                }
                                for (int i = 1; i <= 12; ++i)
                                {
                                    var _i = i;
                                    <div class="hamkare-picker-stick hamkare-hour" style="@($"transform: rotateZ({_i * 30}deg);")" data-stick-value="@_i"></div>
                                }
                            }
                            else
                            {
                                @*Hours from 13 to 24 (00)*@
                                for (int i = 1; i <= 12; ++i)
                                {
                                    var _i = i;
                                    var angle = (6 - _i) * 30;
                                    <HamkareText Class="@GetNumberColor((_i + 12) % 24)" Style="@GetTransform(angle, 109, 0, 5)">@(((_i + 12) % 24).ToString("D2"))</HamkareText>
                                }
                                @*Hours from 1 to 12*@
                                for (int i = 1; i <= 12; ++i)
                                {
                                    var _i = i;
                                    var angle = (6 - _i) * 30;
                                    <HamkareText Class="@GetNumberColor(_i)" Typo="Typo.body2" Style="@GetTransform(angle, 74, 0, 40)">@(_i.ToString("D2"))</HamkareText>
                                }
                                for (int i = 1; i <= 12; ++i)
                                {
                                    var _i = i;
                                    <div class="hamkare-picker-stick" style="@($"transform: rotateZ({_i * 30}deg);")">
                                        <div class="hamkare-picker-stick-inner hamkare-hour" data-stick-value="@_i"></div>
                                        <div class="hamkare-picker-stick-outer hamkare-hour" data-stick-value="@((_i + 12) % 24)"></div>
                                    </div>
                                }
                            }
                        </div>
                        <div class="@MinuteDialClassname">   
                            @*Minutes from 05 to 60 (00) - step 5*@                     
                            @for (int i = 0; i < 12; ++i)
                            {
                                var _i = i;
                                var angle = (6 - _i) * 30;
                                <HamkareText Class="@GetNumberColor(_i * 5)" Style="@GetTransform(angle, 109, 0, 5)">@((_i * 5).ToString("D2"))</HamkareText>
                            }
                            @for (int i = 0; i < 60; ++i)
                            {
                                var _i = i;
                                <div class="hamkare-picker-stick hamkare-minute" style="@($"transform: rotateZ({_i * 6}deg);")" data-stick-value="@_i"></div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </HamkarePickerContent>
    </CascadingValue>;
}
