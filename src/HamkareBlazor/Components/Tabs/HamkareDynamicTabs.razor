@namespace HamkareBlazor
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.AspNetCore.Components.CompilerServices
@using HamkareBlazor.Resources
@inject InternalHamkareLocalizer Localizer
@inherits HamkareTabs

@Render

@{
#pragma warning disable CS0618 // Type or member is obsolete
}

@code {
    /// <inheritdoc />
    protected override void OnInitialized()
    {
        Header = HamkareTabsHeader;
        TabPanelHeader = HamkareTabPanelPanelHeader;
    }

    /// <summary>
    /// Renders the component to the supplied <see cref="BuildRenderTree"/>.
    /// </summary>
    public RenderFragment Render => base.BuildRenderTree;

    private RenderFragment<HamkareTabPanel> HamkareTabPanelPanelHeader => context =>
        @<HamkareRender>
            @if (context.ShowCloseIcon)
            {
                if (!string.IsNullOrEmpty(CloseIconToolTip))
                {
                    <HamkareTooltip Text="@CloseIconToolTip">
                        <HamkareIconButton Icon="@CloseTabIcon"
                                       Class="@CloseIconClass"
                                       Style="@CloseIconStyle"
                                       OnClick="() => CloseTab.InvokeAsync(context)"
                                       @onkeydown="@(e => HandleTabKeyDownAsync(e, context))"
                                       aria-label="@Localizer[LanguageResource.HamkareTabs_CloseTab]"/>
                    </HamkareTooltip>
                }
                else
                {
                    <HamkareIconButton Icon="@CloseTabIcon"
                                   Class="@CloseIconClass"
                                   Style="@CloseIconStyle"
                                   OnClick="() => CloseTab.InvokeAsync(context)"
                                   @onkeydown="@(e => HandleTabKeyDownAsync(e, context))"
                                   aria-label="@Localizer[LanguageResource.HamkareTabs_CloseTab]" />
                }
            }
        </HamkareRender>;

    private RenderFragment<HamkareTabs> HamkareTabsHeader => _ =>
        @<HamkareRender>
            @if (!string.IsNullOrEmpty(AddIconToolTip))
            {
                <HamkareTooltip Text="@AddIconToolTip">
                    <HamkareIconButton Icon="@AddTabIcon" 
                        Class="@AddIconClass" 
                        Style="@AddIconStyle" 
                        OnClick="@AddTab" 
                        aria-label="@Localizer[LanguageResource.HamkareTabs_AddTab]" />
                </HamkareTooltip>
            }
            else
            {
                <HamkareIconButton 
                    Icon="@AddTabIcon" 
                    Class="@AddIconClass" 
                    Style="@AddIconStyle" 
                    OnClick="@AddTab" 
                    aria-label="@Localizer[LanguageResource.HamkareTabs_AddTab]" />
            }
        </HamkareRender>;
}
