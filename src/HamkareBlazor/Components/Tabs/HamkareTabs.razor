@namespace HamkareBlazor
@inherits HamkareComponentBase
@inject InternalHamkareLocalizer Localizer

<div @attributes="UserAttributes" class="@TabsClassnames" style="@Style">
    <CascadingValue Value="this" IsFixed="true">
        <div class="@TabBarClassnames">
            <div @ref="@_tabsInnerSize" class="hamkare-tabs-tabbar-inner" style="@MaxHeightStyles" id="@_elementId">
                @if (HeaderPosition == TabHeaderPosition.Before && Header != null)
                {
                    <div class="hamkare-tabs-header hamkare-tabs-header-before">
                        @Header(this)
                    </div>
                }
                @if (_showScrollButtons)
                {
                    <CascadingValue Value="false" Name="ParentDisabled" IsFixed="true">
                        <div class="hamkare-tabs-scroll-button"
                             @ondragover="@(e => _throttleDispatcher.Value.ThrottleAsync(() => { ScrollPrev(); return Task.CompletedTask; }))">
                            <HamkareIconButton Icon="@_prevIcon" Color="@ScrollIconColor" OnClick="@((e) => ScrollPrev())" Disabled="@_prevButtonDisabled" aria-label="@GetPrevAriaLabel()" />
                        </div>
                    </CascadingValue>
                }
                <div @ref="@_tabsContentSize" class="hamkare-tabs-tabbar-content">
                    @if (EnableDragAndDrop)
                    {
                        <HamkareDropContainer @ref="_dropContainer" T="HamkareTabPanel" Class="@WrapperClassnames" Style="@WrapperScrollStyle" Items="_panels"
                                          ItemsSelector="@((item,dropzone) => true)" ItemDropped="@ItemUpdated"
                                          ItemDisabled="@((item) => Disabled || item.Disabled)" role="tablist">
                            <ChildContent>
                                <HamkareDropZone T="HamkareTabPanel" Identifier="hamkare-tabs-dropzone" Class="@DropZoneClassnames" AllowReorder="true" />
                                @if (!HideSlider && _isSliderPositionDetermined)
                                {
                                    <div class="@SliderClass" style="@SliderStyle"></div>
                                }
                            </ChildContent>
                            <ItemRenderer>
                                @RenderTabWrapperSection(context)
                            </ItemRenderer>
                        </HamkareDropContainer>
                    }
                    else
                    {
                        <div class="@WrapperClassnames" style="@WrapperScrollStyle" role="tablist">
                            @foreach (HamkareTabPanel panel in _panels)
                            {
                                @RenderTabWrapperSection(panel)
                            }
                            @if (!HideSlider && _isSliderPositionDetermined)
                            {
                                <div class="@SliderClass" style="@SliderStyle"></div>
                            }
                        </div>
                    }
                </div>
                @if (_showScrollButtons)
                {
                    <CascadingValue Value="false" Name="ParentDisabled" IsFixed="true">
                        <div class="hamkare-tabs-scroll-button"
                             @ondragover="@(e => _throttleDispatcher.Value.ThrottleAsync(() => { ScrollNext(); return Task.CompletedTask; }))">
                            <HamkareIconButton Icon="@_nextIcon" Color="@ScrollIconColor" OnClick="@((e) => ScrollNext())" Disabled="@_nextButtonDisabled" aria-label="@GetNextAriaLabel()" />
                        </div>
                    </CascadingValue>
                }
                @if (HeaderPosition == TabHeaderPosition.After && Header != null)
                {
                    <div class="hamkare-tabs-header hamkare-tabs-header-after">
                        @Header(this)
                    </div>
                }
            </div>
        </div>
        @if (PrePanelContent is not null && ActivePanel is not null)
        {
            @PrePanelContent(ActivePanel)
        }
        <div class="@PanelsClassnames">
            @ChildContent
        </div>
    </CascadingValue>
</div>

@code {
    private RenderFragment RenderTabWrapperSection(HamkareTabPanel panel) =>
        @<text>
            @if (panel.TabContent is null && panel.TabWrapperContent is null)
            {
                <HamkareTooltip Placement="@GetTooltipPlacement()" Text="@panel.ToolTip" @key="@panel">
                    @RenderTab(panel)
                </HamkareTooltip>
            }
            else
            {
                <div class="d-inline-block" style="width: fit-content;" @key="@panel">
                    @if (panel.TabWrapperContent is null)
                    {
                        @RenderTab(panel)
                    }
                    else
                    {
                        @panel.TabWrapperContent(RenderTab(panel))
                    }
                </div>
            }
        </text>;

    private RenderFragment RenderTab(HamkareTabPanel panel) =>
        @<div @ref="panel.PanelRef" class="@GetTabClass(panel)" style="@GetTabStyle(panel)" @onclick="@(e => ActivatePanelClickAsync(panel, e, false))" @onmousedown="panel.OnMouseDown" @oncontextmenu="panel.OnContextMenu" @oncontextmenu:preventDefault="@(panel.OnContextMenu.HasDelegate)"
              aria-controls="@GetTabPanelId(panel)" role="tab" id="@GetTabId(panel)" aria-selected="@(panel == ActivePanel ? "true" : "false")"
              tabindex="@(panel == ActivePanel ? "0" : "-1")" @onkeydown="@(e => HandleTabKeyDownAsync(e, panel))">
            @if (TabPanelHeaderPosition == TabHeaderPosition.Before && TabPanelHeader is not null)
            {
                <div class="hamkare-tabs-panel-header hamkare-tabs-panel-header-before">
                    @TabPanelHeader(panel)
                </div>
            }
            @if (panel.TabContent is not null)
            {
                @panel.TabContent
            }
            else if (!string.IsNullOrEmpty(panel.Text) && string.IsNullOrEmpty(panel.Icon))
            {
                @panel.Text
            }
            else if (string.IsNullOrEmpty(panel.Text) && !string.IsNullOrEmpty(panel.Icon))
            {
                <HamkareIcon Icon="@panel.Icon" Color="@GetPanelIconColor(panel)" />
            }
            else if (!string.IsNullOrEmpty(panel.Text) && !string.IsNullOrEmpty(panel.Icon))
            {
                <HamkareIcon Icon="@panel.Icon" Color="@GetPanelIconColor(panel)" Class="hamkare-tab-icon-text" />
                @panel.Text
            }
            @if (panel.BadgeData is not null || panel.BadgeIcon is not null || panel.BadgeDot)
            {
                <HamkareBadge Dot="@panel.BadgeDot" Content="@panel.BadgeData" Icon="@panel.BadgeIcon" Max="@panel.BadgeMax" Color="@panel.BadgeColor" Class="hamkare-tab-badge" />
            }
            @if (TabPanelHeaderPosition == TabHeaderPosition.After && TabPanelHeader is not null)
            {
                <div class="hamkare-tabs-panel-header hamkare-tabs-panel-header-after">
                    @TabPanelHeader(panel)
                </div>
            }
        </div>;
}
